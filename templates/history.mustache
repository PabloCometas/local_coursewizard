{{!
    @template local_coursewizard/history

    Chat history of the guided course creation dialog: answered steps with their
    answers, after the last required step the offer to create the course right
    away, then the question of the current step.

    Context variables required for this template:
    * answered - Answered steps: index, question, answer, decision (after the last
      required step, otherwise null): text, decided (more details chosen), answer.
    * question - Question of the current step, empty while the decision is open.

    Example context (json):
    {
        "answered": [
            {
                "index": 0,
                "question": "Wie soll dein neuer Kurs heissen?",
                "answer": "Excel Grundlagen",
                "decision": {
                    "text": "Danke, Anna! Du hast alles Nötige angegeben und kannst den Kurs jetzt anlegen.",
                    "decided": false,
                    "answer": "Weitere Angaben machen"
                }
            }
        ],
        "question": ""
    }
}}
{{#answered}}
    <div class="coursewizard-msg coursewizard-msg-bot">{{question}}</div>
    <div class="coursewizard-msg coursewizard-msg-user">
        <span class="coursewizard-answer">{{answer}}</span>
        <button type="button" class="btn btn-link btn-sm p-0 coursewizard-edit" data-action="edit" data-step="{{index}}">
            {{#str}}edit{{/str}}
        </button>
    </div>
    {{#decision}}
        <div class="alert alert-success coursewizard-decision" role="status">
            <p class="coursewizard-decision-text">{{text}}</p>
            {{^decided}}
                <div class="coursewizard-choices">
                    <button type="button" class="btn btn-primary btn-lg" data-action="create">
                        {{#str}}createnow, local_coursewizard{{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-lg" data-action="more">
                        {{#str}}moredetails, local_coursewizard{{/str}}
                    </button>
                </div>
            {{/decided}}
        </div>
        {{#decided}}
            <div class="coursewizard-msg coursewizard-msg-user">
                <span class="coursewizard-answer">{{answer}}</span>
            </div>
        {{/decided}}
    {{/decision}}
{{/answered}}
{{#question}}
    <div class="coursewizard-msg coursewizard-msg-bot">{{question}}</div>
{{/question}}
