{{!
    @template local_coursewizard/history

    Chat history of the guided course creation dialog: answered steps with their
    answers, then the question of the current step.

    Context variables required for this template:
    * answered - Answered steps: index, question, answer, hint (message after the answer, may be empty).
    * question - Question of the current step.

    Example context (json):
    {
        "answered": [
            {"index": 0, "question": "Wie soll dein neuer Kurs heissen?", "answer": "Excel Grundlagen", "hint": ""}
        ],
        "question": "In welcher Kategorie soll dein Kurs erscheinen?"
    }
}}
{{#answered}}
    <div class="coursewizard-msg coursewizard-msg-bot">{{question}}</div>
    <div class="coursewizard-msg coursewizard-msg-user">
        <span class="coursewizard-answer">{{answer}}</span>
        <button type="button" class="btn btn-link btn-sm p-0 coursewizard-edit" data-action="edit" data-step="{{index}}">
            {{#str}}edit{{/str}}
        </button>
    </div>
    {{#hint}}
        <div class="coursewizard-msg coursewizard-msg-bot">{{hint}}</div>
    {{/hint}}
{{/answered}}
<div class="coursewizard-msg coursewizard-msg-bot">{{question}}</div>
