{{!
    @template local_coursewizard/history

    Chat history of the guided course creation dialog: answered steps with their
    answers, after the last required step the offer to create the course right
    away, then the question of the current step (with the "Later" chip if the
    step is optional).

    Context variables required for this template:
    * answered - Answered steps: index, question, answer, decision (after the last
      required step, otherwise null): text, decided (more details chosen), answer.
    * question - Question of the current step, empty while the decision is open.
    * later - Whether the current step can be skipped.

    Example context (json):
    {
        "answered": [
            {
                "index": 0,
                "question": "Wie soll dein neuer Kurs heissen?",
                "answer": "Excel Grundlagen",
                "decision": {
                    "text": "Danke, Anna! Du hast alles Nötige angegeben und kannst den Kurs jetzt anlegen.",
                    "decided": false,
                    "answer": "Weitere Angaben machen"
                }
            }
        ],
        "question": "",
        "later": false
    }
}}
{{#answered}}
    {{#question}}{{> local_coursewizard/bot_message }}{{/question}}
    <div class="coursewizard-user">
        <span class="coursewizard-answer">{{answer}}</span>
        <button type="button" class="coursewizard-edit" data-action="edit" data-step="{{index}}"
                title="{{#str}}edit{{/str}}" aria-label="{{#str}}edit{{/str}}">
            <i class="icon fa fa-pen fa-fw m-0" aria-hidden="true"></i>
        </button>
    </div>
    {{#decision}}
        <div class="coursewizard-decision" role="status">
            <div class="coursewizard-decision-body">
                <i class="icon fa fa-circle-check fa-fw m-0 coursewizard-decision-icon" aria-hidden="true"></i>
                <p class="coursewizard-decision-text">{{text}}</p>
            </div>
            {{^decided}}
                <div class="coursewizard-choices">
                    <button type="button" class="btn btn-primary rounded-pill" data-action="create">
                        {{#str}}createnow, local_coursewizard{{/str}}
                    </button>
                    <button type="button" class="btn btn-light rounded-pill coursewizard-pill" data-action="more">
                        {{#str}}moredetails, local_coursewizard{{/str}}
                    </button>
                </div>
            {{/decided}}
        </div>
        {{#decided}}
            <div class="coursewizard-user">
                <span class="coursewizard-answer">{{answer}}</span>
            </div>
        {{/decided}}
    {{/decision}}
{{/answered}}
{{#question}}{{> local_coursewizard/bot_message }}{{/question}}
{{#later}}
    <div class="coursewizard-chips">
        <button type="button" class="coursewizard-chip" data-action="later">{{#str}}later, local_coursewizard{{/str}}</button>
    </div>
{{/later}}
