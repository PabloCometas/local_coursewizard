{{!
    @template local_coursewizard/history

    Chat history of the guided course creation dialog: answered steps with their
    answers, after the last required step the offer to create the course right
    away, then the question of the current step.

    Context variables required for this template:
    * answered - Answered steps: index, question, explanation (if asked for),
      answers (label, value and images per field: preview of an uploaded image
      instead of its name), hasimages (the answer is an image: picture over the full
      width, label below), choices (instead of answers: buttons
      that stay, see local_coursewizard/choices), fresh (just answered,
      slides in), decision (after the last required step while still open,
      otherwise null): text.
    * question - Question of the current step, empty while the decision is open.
    * explain - Show the button "What is this for?" after the question.
    * explanation - Explanation of the current step, once asked for.
    * templateimage - Image of the chosen template at the image step (src, text), or null.

    Example context (json):
    {
        "answered": [
            {
                "index": 0,
                "question": "What should your new course be called?",
                "explanation": "",
                "choices": [],
                "answers": [
                    {
                        "label": "Course name",
                        "value": "Excel basics",
                        "images": []
                    }
                ],
                "hasimages": false,
                "fresh": true,
                "decision": {
                    "text": "Thanks, Anna! You have entered everything needed and can open your course now."
                }
            }
        ],
        "question": "",
        "explain": false,
        "explanation": "",
        "templateimage": null
    }
}}
{{#answered}}
    {{#question}}{{> local_coursewizard/bot_message }}{{/question}}
    {{#explanation}}{{> local_coursewizard/bot_message }}{{/explanation}}
    {{#choices.0}}
        <div class="coursewizard-quick coursewizard-quick-answered{{#fresh}} coursewizard-fresh{{/fresh}}" role="group">
            {{> local_coursewizard/choices }}
        </div>
    {{/choices.0}}
    {{^choices.0}}
    <div class="coursewizard-user{{#hasimages}} coursewizard-user-image{{/hasimages}}{{#fresh}} coursewizard-fresh{{/fresh}}">
        <span class="coursewizard-answers">
            {{#answers}}
                <span class="coursewizard-answer">
                    {{#images.0}}
                        <span class="coursewizard-answer-images">
                            {{#images}}<img src="{{src}}" alt="{{name}}" class="coursewizard-answer-image">{{/images}}
                        </span>
                        <span class="coursewizard-answer-label">{{label}}</span>
                    {{/images.0}}
                    {{^images.0}}
                        {{#label}}<span class="coursewizard-answer-label">{{label}}</span>{{/label}}
                        <span class="coursewizard-answer-value">{{value}}</span>
                    {{/images.0}}
                </span>
            {{/answers}}
        </span>
        <button type="button" class="coursewizard-edit" data-action="edit" data-step="{{index}}"
                title="{{#str}}edit{{/str}}" aria-label="{{#str}}edit{{/str}}">
            <i class="icon fa fa-pen fa-fw m-0" aria-hidden="true"></i>
        </button>
    </div>
    {{/choices.0}}
    {{#decision}}
        <div class="coursewizard-decision" role="status">
            <p class="coursewizard-decision-text">{{text}}</p>
            <div class="coursewizard-choices">
                <button type="button" class="btn btn-primary rounded-pill" data-action="create">
                    {{#str}}createnow, local_coursewizard{{/str}}
                </button>
                <button type="button" class="btn btn-light rounded-pill coursewizard-pill" data-action="more">
                    {{#str}}moredetails, local_coursewizard{{/str}}
                </button>
            </div>
        </div>
    {{/decision}}
{{/answered}}
{{#question}}
    <div class="coursewizard-bot">
        <div class="coursewizard-bot-text">
            {{question}}
            {{#explain}}
                <button type="button" class="coursewizard-explain" data-action="explain">
                    {{#str}}explain, local_coursewizard{{/str}}
                </button>
            {{/explain}}
            {{#templateimage}}
                <span class="coursewizard-template-image">
                    <img src="{{src}}" alt="">
                    <span>{{text}}</span>
                </span>
            {{/templateimage}}
        </div>
    </div>
{{/question}}
{{#explanation}}{{> local_coursewizard/bot_message }}{{/explanation}}
