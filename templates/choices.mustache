{{!
    @template local_coursewizard/choices

    Answers of a select as buttons in the chat (e.g. visibility, course template).
    With images (templates) every choice is a card, the others show their icon instead.

    Context variables required for this template:
    * choices - step (index of the step in the history, empty for the current step),
      name, value, label, icon, image, url (to view it), selected, card.

    Example context (json):
    {
        "choices": [
            {
                "step": "",
                "name": "templateid",
                "value": "0",
                "label": "Empty course",
                "icon": "fa-file",
                "image": "",
                "url": "",
                "selected": true,
                "card": true
            }
        ]
    }
}}
{{#choices}}
    <span class="coursewizard-option">
        <button type="button" class="coursewizard-choice{{#card}} coursewizard-choice-card{{/card}}" data-action="choose"
                data-step="{{step}}" data-name="{{name}}" data-value="{{value}}"
                aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">
            {{#card}}
                <span class="coursewizard-choice-thumb">
                    {{#image}}<img src="{{image}}" alt="">{{/image}}
                    {{^image}}<i class="icon fa {{icon}} fa-fw m-0" aria-hidden="true"></i>{{/image}}
                </span>
            {{/card}}
            {{^card}}
                {{#icon}}<i class="icon fa {{icon}} fa-fw" aria-hidden="true"></i>{{/icon}}
            {{/card}}
            <span class="coursewizard-choice-label">{{label}}</span>
        </button>
        {{#url}}
            <a href="{{url}}" target="_blank" class="coursewizard-choice-view">{{#str}}viewtemplate, local_coursewizard{{/str}}</a>
        {{/url}}
    </span>
{{/choices}}
